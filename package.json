{
  "name": "fizlab",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:doctor": "tsx scripts/db-doctor.ts",
    "learning:prune": "tsx scripts/prune-learning.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx scripts/test-e2e.ts",
    "typecheck": "tsc --noEmit",
    "teacher:invite": "tsx scripts/invite-teacher.ts",
    "format": "prettier --write app components lib prisma/*.ts scripts tests *.ts *.json *.yaml *.md",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "account:recover": "tsx scripts/recover-account.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^18.0.9",
    "html-to-pdfmake": "2.5.36",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "nodemailer": "^10.2.1",
    "pdfmake": "0.2.20",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/html-to-pdfmake": "2.4.4",
    "@types/node": "^24.0.0",
    "@types/pdfmake": "0.2.12",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
