DATABASE_URL="postgresql://fizlab:fizlab_local@localhost:5432/fizlab?schema=public"
APP_URL="http://localhost:3000"
# Set true only behind HTTPS in production.
COOKIE_SECURE="false"
# Optional: DATABASE_URL for a separate disposable end-to-end test database.
TEST_DATABASE_URL="postgresql://fizlab:fizlab_local@localhost:5432/fizlab_test?schema=public"

# Optional Gmail SMTP: enable Google 2-Step Verification and create an App Password.
# Never commit your real password. Leave blank to keep email sending disabled.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
# Optional verified sender; defaults to SMTP_USER.
SMTP_FROM=""
# Public HTTPS site address for invitation links; defaults to APP_URL.
# localhost cannot be used in invitations.
PUBLIC_APP_URL=""
